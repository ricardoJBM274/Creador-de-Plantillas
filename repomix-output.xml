<file path="index.html">
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Generador de Capturas Play Store</title>
    <link rel="stylesheet" href="estilos.css">
</head>
<body>
    <div class="contenedor">
        <aside class="panel-controles">
            <h2>Controles</h2>

            <div class="seccion-pantallas">
                <h3>Vistas del Proyecto</h3>
                <div id="listaPantallas" class="lista-pantallas"></div>
                <div style="display: flex; gap: 5px; margin-top: 10px;">
                    <button id="btnNuevaPantalla" class="btn-secundario" style="flex: 1; margin-top: 0;">+ Añadir</button>
                    <button id="btnEliminarPantalla" class="btn-peligro" style="flex: 1;">- Eliminar</button>
                </div>
            </div>
            <hr class="divisor">
            
            <div class="control-grupo">
                <label for="tipoDispositivo">Formato de Pantalla:</label>
                <select id="tipoDispositivo">
                    <option value="telefono">Teléfono (1080 x 1920)</option>
                    <option value="tablet">Tablet 10" (1600 x 2560)</option>
                </select>
            </div>

            <div class="control-grupo">
                <label for="tituloInput">Título del Banner:</label>
                <input type="text" id="tituloInput" value="¡Descarga mi App!" style="margin-bottom: 5px;">
                <select id="fuenteTexto">
                    <option value="sans-serif">Sans-Serif (Moderna)</option>
                    <option value="serif">Serif (Clásica)</option>
                    <option value="Impact, sans-serif">Impact (Llamativa)</option>
                    <option value="'Courier New', Courier, monospace">Courier (Código)</option>
                </select>
            </div>

            <details class="panel-avanzado">
                <summary>Avanzado: Posición de Texto</summary>
                <div class="grupo-desplegable">
                    <div class="control-vertical">
                        <label for="textoX">Mover Horizontalmente (Eje X):</label>
                        <input type="range" id="textoX" min="-1000" max="1000" value="0">
                    </div>
                    <div class="control-vertical">
                        <label for="textoY">Mover Verticalmente (Eje Y):</label>
                        <input type="range" id="textoY" min="-1000" max="1000" value="0">
                    </div>
                    <div class="control-vertical">
                        <label for="textoRot">Rotación (°):</label>
                        <input type="range" id="textoRot" min="-180" max="180" value="0">
                    </div>
                </div>
            </details>

            <div class="control-grupo" style="flex-direction: row; align-items: center; gap: 10px; margin-bottom: 15px;">
                <input type="checkbox" id="sombraTexto">
