                    <div class="control-vertical">
                        <label for="dispY">Mover Verticalmente (Eje Y):</label>
                        <input type="range" id="dispY" min="-1000" max="1000" value="0">
                    </div>
                    <div class="control-vertical">
                        <label for="dispRot">Rotación (°):</label>
                        <input type="range" id="dispRot" min="-180" max="180" value="0">
                    </div>
                </div>
            </details>

            <hr class="divisor">
            <div class="control-grupo" style="flex-direction: row; align-items: center; gap: 10px;">
