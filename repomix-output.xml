            <div id="panelDisp2" style="display: none; border-left: 2px solid #00e676; padding-left: 10px; margin-bottom: 15px;">
                
                <div class="control-grupo">
                    <label for="escalaDispositivo2">Tamaño 2º Disp: <span id="escalaValor2">100%</span></label>
                    <input type="range" id="escalaDispositivo2" min="50" max="200" value="100">
                </div>

                <details class="panel-avanzado">
                    <summary>Avanzado: Posición 2º Disp</summary>
                    <div class="grupo-desplegable">
                        <div class="control-vertical">
                            <label>Mover Horizontalmente (Eje X):</label>
                            <input type="range" id="dispX2" min="-1000" max="1000" value="0">
                        </div>
                        <div class="control-vertical">
                            <label>Mover Verticalmente (Eje Y):</label>
                            <input type="range" id="dispY2" min="-1000" max="1000" value="0">
                        </div>
                        <div class="control-vertical">
                            <label>Rotación (°):</label>
                            <input type="range" id="dispRot2" min="-180" max="180" value="0">
                        </div>
                    </div>
                </details>

                <div class="control-grupo">
                    <label>Subir Captura (2º Disp):</label>
                    <input type="file" id="imagenUpload2" accept="image/png, image/jpeg">
                </div>
            </div>

            <div style="display: flex; gap: 10px; margin-bottom: 15px;">
                <div class="control-grupo" style="flex: 1;">
                    <label for="colorFondo">Fondo:</label>
                    <input type="color" id="colorFondo" value="#2c3e50" style="width: 100%;">
                </div>
                <div class="control-grupo" style="flex: 1;">
                    <label for="colorTexto">Texto:</label>
                    <input type="color" id="colorTexto" value="#ffffff" style="width: 100%;">
                </div>
            </div>

            <div class="control-grupo">
                <label for="imagenUpload">Subir Captura de App:</label>
                <input type="file" id="imagenUpload" accept="image/png, image/jpeg">
            </div>

            <button id="btnDescargar" class="btn-accion">Descargar Diseño (PNG)</button>

            <hr class="divisor">
            
            <div class="control-grupo">
                <label for="nombrePlantilla">Nombre del Archivo JSON:</label>
                <input type="text" id="nombrePlantilla" value="mi_proyecto" placeholder="Ej: vista_login">
            </div>

            <button id="btnExportar" class="btn-secundario">Guardar Proyecto</button>
            <label for="btnImportar" class="btn-secundario text-center">Cargar Proyecto</label>
            <input type="file" id="btnImportar" accept=".json" style="display: none;">

        </aside>

        <main class="area-canvas">
            <canvas id="lienzo" width="1080" height="1920"></canvas>
        </main>
    </div>
    
    <script src="app.js"></script>
</body>
